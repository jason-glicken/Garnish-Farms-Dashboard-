+        // Normalize status text once so Home-page filters are not sensitive to
+        // capitalization or accidental leading/trailing whitespace in Supabase.
+        function normalizeBatchStatus(value) {
+            const raw = String(value ?? '').trim();
+            const key = raw.toLowerCase().replace(/[\s_-]+/g, ' ');
+            if (key === 'active' || key === 'in progress') return 'Active';
+            if (key === 'harvested' || key === 'complete' || key === 'completed') return 'Harvested';
+            if (key === 'contaminated') return 'Contaminated';
+            return raw;
+        }
